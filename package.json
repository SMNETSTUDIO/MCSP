{
  "name": "mcsp",
  "version": "1.0.0",
  "description": "MineCraft Server Panel — Apple liquid-glass style web panel for managing a Minecraft server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "deploy": "bash scripts/deploy.sh",
    "dev": "node server.js",
    "test": "node scripts/smoke.js",
    "pm2": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop mcsp",
    "pm2:logs": "pm2 logs mcsp"
  },
  "keywords": [
    "minecraft",
    "server",
    "panel",
    "dashboard",
    "liquid-glass"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "pm2": "^7.0.3"
  }
}
